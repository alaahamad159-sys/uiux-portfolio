---
import '../styles.css';
const {title='Alaa Ahmad — Junior UI/UX Designer',description='Alaa Ahmad is a junior UI/UX designer based in Riyadh, Saudi Arabia, creating thoughtful digital experiences.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><title>{title}</title><script is:inline>try{const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch(e){}</script></head><body><header class="site-header"><a href="/" class="brand" aria-label="Alaa Ahmad home">alaa<span class="brand-dot">.</span></a><nav aria-label="Main navigation"><a href="/work">Work</a><a href="/about">About</a><a href="/contact">Contact</a></nav><div class="header-right"><button class="theme-button" aria-label="Toggle light and dark theme" title="Toggle theme">◐</button><a class="header-cta" href="/contact">Let's talk ↗</a></div></header><main><slot/></main><footer class="footer"><div><span class="footer-wordmark">Let's make something meaningful<span class="brand-dot">.</span></span><p>Open to thoughtful conversations and new opportunities.</p></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Alaa Ahmad</span><span>Designed with curiosity. Built with care.</span><a href="https://www.linkedin.com/in/alaa-hamad" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://www.behance.net/alaahamad" target="_blank" rel="noopener noreferrer">Behance ↗</a><a href="/contact">Contact ↗</a></div></footer><script is:inline>document.querySelector('.theme-button')?.addEventListener('click',()=>{const n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;try{localStorage.setItem('theme',n)}catch(e){}});if('IntersectionObserver'in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target)}}),{threshold:.08});document.querySelectorAll('.reveal').forEach(e=>io.observe(e));}else document.querySelectorAll('.reveal').forEach(e=>e.classList.add('visible'));</script></body></html>