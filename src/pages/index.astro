---
import Base from '../layouts/Base.astro';import ProjectCard from '../components/ProjectCard.astro';import {projects} from '../data/projects';
---
<Base><section class="hero wrap"><div class="hero-top"><span class="eyebrow"><span class="availability-dot"></span> JUNIOR UI/UX DESIGNER · OPEN TO OPPORTUNITIES</span><span class="hero-index">PORTFOLIO / 2026</span></div><h1 class="hero-title">Designing for <em>people.</em><br/>Thinking beyond <em>pixels.</em></h1><div class="hero-bottom"><p>Hey, I'm Alaa — a UI/UX designer with a background in customer experience and a curiosity for making digital products feel simpler, clearer, and more human.</p><a class="round-link" href="#work" aria-label="Scroll to selected work">↓</a></div><div class="hero-rule"></div></section><section class="work-section wrap" id="work"><div class="section-top reveal"><div><span class="eyebrow">01 / SELECTED WORK</span><h2>Ideas made <em>tangible.</em></h2></div><a href="/work" class="text-link">All projects ↗</a></div><div class="projects-grid"><ProjectCard project={projects[0]} large/><ProjectCard project={projects[1]}/><ProjectCard project={projects[2]}/><ProjectCard project={projects[3]}/></div></section><section class="approach-section"><div class="wrap approach-grid"><div class="reveal"><span class="eyebrow">02 / MY APPROACH</span><h2>Good design starts with <em>better questions.</em></h2></div><div class="approach-steps reveal">{[['01','Discover','Understand people and context.'],['02','Define','Identify meaningful design opportunities.'],['03','Design','Explore and shape thoughtful experiences.'],['04','Refine','Learn from feedback and improve.']].map(s=><div><span>{s[0]}</span><h3>{s[1]}</h3><p>{s[2]}</p></div>)}</div></div></section><section class="about-teaser wrap reveal"><span class="eyebrow">03 / ABOUT ME</span><div><h2>Analytical by background.<br/><em>Creative by choice.</em></h2><p>Before design, I spent years studying customer experiences and quality. Now I bring that curiosity into UI/UX.</p><a class="text-link" href="/about">More about me ↗</a></div></section><section class="contact-band wrap reveal"><span class="eyebrow">04 / WHAT'S NEXT?</span><h2>Let's create something <em>worth using.</em></h2><a href="/contact" class="contact-pill">Get in touch ↗</a></section></Base>