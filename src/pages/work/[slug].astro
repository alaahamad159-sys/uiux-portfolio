---
import Base from '../../layouts/Base.astro';import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,i)=>({params:{slug:project.slug},props:{project,next:projects[(i+1)%projects.length]}}))}
const {project,next}=Astro.props;
---
<Base title={`${project.title} — Case Study | Alaa Ahmad`} description={project.description}><article class="case-study wrap"><a class="back-link" href="/work">← All projects</a><div class="case-head"><span class="eyebrow">{project.eyebrow} / {project.year}</span><h1>{project.title}<span class="brand-dot">.</span></h1><p>{project.description}</p></div><div class="case-art" style={`--project-accent:${project.accent}`}><span class="case-symbol">{project.icon}</span><span>{project.title}</span></div><div class="case-facts"><div><span>TYPE</span><strong>{project.category}</strong></div><div><span>STATUS</span><strong>{project.status}</strong></div><div><span>YEAR</span><strong>{project.year}</strong></div></div><div class="case-section"><span class="eyebrow">01 / THE CHALLENGE</span><div><h2>Understanding the <em>problem.</em></h2><p>{project.challenge}</p></div></div><div class="case-section"><span class="eyebrow">02 / DESIGN THINKING</span><div><h2>From observations to <em>direction.</em></h2><ol class="case-list">{project.approach.map(s=><li>{s}</li>)}</ol></div></div><div class="case-section"><span class="eyebrow">03 / REFLECTION</span><div><h2>What comes <em>next.</em></h2><p>{project.outcome}</p><div class="placeholder-note">This case study is a draft. Add verified research, real screenshots and results before presenting as completed work.</div></div></div><a class="next-project" href={`/work/${next.slug}/`}><span>UP NEXT</span><strong>{next.title} ↗</strong></a></article></Base>